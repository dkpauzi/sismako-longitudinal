# =============================================================================
#  TEMPLATE .env UNTUK PRODUCTION (Hostinger Business — shared hosting)
# =============================================================================
#  Cara pakai: salin isi file ini menjadi `.env` DI SERVER, lalu isi bagian
#  yang bertanda <ISI>. JANGAN pernah commit file .env asli ke Git.
# =============================================================================

APP_NAME="SMP Negeri 45 Sijunjung"
APP_ENV=production
# Kosongkan, lalu jalankan: php artisan key:generate
APP_KEY=
# WAJIB false di production. true akan membocorkan stack trace + isi .env.
APP_DEBUG=false
# WIB (Sijunjung, Sumatera Barat)
APP_TIMEZONE=Asia/Jakarta
# WAJIB domain asli + https (dipakai untuk canonical, sitemap, link email).
APP_URL=https://<ISI-DOMAIN-ANDA>

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Biaya hash. 12 aman. Impor massal otomatis memakai min(8, nilai ini).
BCRYPT_ROUNDS=12

# --- LOG -------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Jangan 'debug' di production (file log membengkak & bocor data).
LOG_LEVEL=error

# --- DATABASE (dari hPanel > Databases > MySQL) -----------------------------
# Hostinger memberi nama ber-prefix, contoh: u123456789_sismako
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<ISI-NAMA-DATABASE>
DB_USERNAME=<ISI-USER-DATABASE>
DB_PASSWORD=<ISI-PASSWORD-DATABASE>

# --- SESSION / CACHE / QUEUE ----------------------------------------------
# WAJIB 'database' (shared hosting tidak punya Redis).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Aktifkan HANYA jika domain sudah https (Hostinger menyediakan SSL gratis).
SESSION_SECURE_COOKIE=true

# WAJIB 'sync'. Shared hosting TIDAK punya worker; 'database' akan membuat
# job menumpuk dan tidak pernah dijalankan.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

FILESYSTEM_DISK=local

# --- EMAIL (Hostinger > Emails). Dibutuhkan untuk reset password. ----------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=<ISI-EMAIL>
MAIL_PASSWORD=<ISI-PASSWORD-EMAIL>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="<ISI-EMAIL>"
MAIL_FROM_NAME="${APP_NAME}"

# --- AKUN ADMIN AWAL (dipakai RolePermissionSeeder/SchoolSeeder) ----------
ADMIN_EMAIL=<ISI-EMAIL-ADMIN>
ADMIN_PASSWORD=<ISI-PASSWORD-ADMIN-YANG-KUAT>
